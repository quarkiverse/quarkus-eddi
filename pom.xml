<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse</groupId>
        <artifactId>quarkiverse-parent</artifactId>
        <version>18</version>
    </parent>

    <groupId>io.quarkiverse.eddi</groupId>
    <artifactId>quarkus-eddi-parent</artifactId>
    <version>6.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Quarkus EDDI - Parent</name>
    <description>Quarkus extension for the EDDI conversational AI platform</description>
    <url>https://github.com/quarkiverse/quarkus-eddi</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>labsai</id>
            <name>labs.ai</name>
            <organization>labs.ai</organization>
            <organizationUrl>https://labs.ai</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:quarkiverse/quarkus-eddi.git</connection>
        <developerConnection>scm:git:git@github.com:quarkiverse/quarkus-eddi.git</developerConnection>
        <url>https://github.com/quarkiverse/quarkus-eddi</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/quarkiverse/quarkus-eddi/issues</url>
    </issueManagement>

    <modules>
        <module>runtime</module>
        <module>deployment</module>
    </modules>

    <properties>
        <quarkus.version>3.37.2</quarkus.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
